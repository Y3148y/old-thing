    <!-- 蓝牙设备列表 -->
    <LinearLayout
        android:id="@+id/bluetooth_device_container"
        android:layout_width="250dp"
        android:layout_height="270dp"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="蓝牙设备列表"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#E0E0E0"
            android:padding="8dp" />

        <ListView
            android:id="@+id/bluetooth_device_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:divider="#CCCCCC"
            android:dividerHeight="1dp" />

        <Button
            android:id="@+id/close_device_list_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="关闭"
            android:textSize="14sp" />

    </LinearLayout>

    <include
        android:id="@+id/activity_mode"
        layout="@layout/activity_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="88dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
         />
    <com.example.hc.MyRockerView
        android:id="@+id/myRockerView3"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginStart="0dp"
        android:layout_marginBottom="5dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        rocker:areaBackground="@mipmap/rocker_base"
        rocker:rockerBackground="@mipmap/rocker"
        rocker:rockerCallBackMode="CALL_BACK_MODE_STATE_CHANGE"
        rocker:rockerScale="0.5"
        rocker:rockerSpeedLevel="10" />

    <Button
        android:id="@+id/change"
        android:layout_width="91dp"
        android:layout_height="62dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:background="@drawable/change"
        android:foreground="?selectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/map2"
        layout="@layout/map2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        />
    <include
        android:id="@+id/map1"
        layout="@layout/map1"
        android:layout_width="700dp"
        android:layout_height="match_parent"
        android:visibility="visible" />


    <com.google.android.material.slider.Slider
        android:id="@+id/seekbar02"
        android:layout_width="250dp"
        android:layout_height="63dp"
        android:layout_row="0"
        android:layout_column="1"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="600dp"
        android:layout_marginBottom="152dp"
        android:foreground="?selectableItemBackground"
        android:rotation="270"
        android:stepSize="1"
        android:value="0"
        android:valueFrom="0"
        android:valueTo="4"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:tickVisible="true"
        app:trackHeight="9dp"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/begin"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="508dp"
        android:layout_marginTop="92dp"
        android:background="@drawable/begin"
        android:foreground="?selectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/stop"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="516dp"
        android:layout_marginTop="208dp"
        android:background="@drawable/stopp"
        android:foreground="?selectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/touqiu"
        android:layout_width="80dp"
        android:layout_height="70dp"
        android:layout_marginStart="516dp"
        android:layout_marginTop="88dp"
        android:background="@drawable/touqiu"
        android:foreground="?selectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/yunqiu"
        android:layout_width="80dp"
        android:layout_height="70dp"
        android:layout_marginStart="448dp"
        android:layout_marginTop="156dp"
        android:background="@drawable/yun_qiu"
        android:foreground="?selectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/chuanqiu"
        android:layout_width="80dp"
        android:layout_height="70dp"
        android:layout_marginStart="568dp"
        android:layout_marginTop="156dp"
        android:background="@drawable/chuan_qiu"
        android:foreground="?selectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/jieqiu"
        android:layout_width="80dp"
        android:layout_height="70dp"
        android:layout_marginStart="516dp"
        android:layout_marginTop="216dp"
        android:background="@drawable/jie_qiu"
        android:foreground="?selectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/reset"
        android:layout_width="80dp"
        android:layout_height="70dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="100dp"
        android:background="@drawable/reset"
        android:foreground="?selectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <Button
        android:id="@+id/reset2"
        android:layout_width="80dp"
        android:layout_height="70dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="100dp"
        android:background="@drawable/reset"
        android:foreground="?selectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 四个方向按键 - 右下角滑动条右边 -->
    <!-- 中心参考点 -->
    <View
        android:id="@+id/main_center_point"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginEnd="75dp"
        android:layout_marginBottom="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 上方向按键 -->
    <Button
        android:id="@+id/main_btn_direction_up"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="6dp"
        android:text="▲"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/colorPrimary"
        app:layout_constraintBottom_toTopOf="@+id/main_center_point"
        app:layout_constraintEnd_toEndOf="@+id/main_center_point"
        app:layout_constraintStart_toStartOf="@+id/main_center_point" />

    <!-- 下方向按键 -->
    <Button
        android:id="@+id/main_btn_direction_down"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:text="▼"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="@+id/main_center_point"
        app:layout_constraintStart_toStartOf="@+id/main_center_point"
        app:layout_constraintTop_toBottomOf="@+id/main_center_point" />

    <!-- 左方向按键 -->
    <Button
        android:id="@+id/main_btn_direction_left"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="6dp"
        android:text="◀"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@+id/main_center_point"
        app:layout_constraintEnd_toStartOf="@+id/main_center_point"
        app:layout_constraintTop_toTopOf="@+id/main_center_point" />

    <!-- 右方向按键 -->
    <Button
        android:id="@+id/main_btn_direction_right"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="6dp"
        android:text="▶"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@+id/main_center_point"
        app:layout_constraintStart_toEndOf="@+id/main_center_point"
        app:layout_constraintTop_toTopOf="@+id/main_center_point" />

    <!-- 跳转到AdjustActivity的按钮 -->
    <Button
        android:id="@+id/btn_goto_adjust"
        android:layout_width="90dp"
        android:layout_height="45dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/purple"
        android:text="调试页面"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:foreground="?selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>